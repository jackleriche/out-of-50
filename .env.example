# Local: docker compose up -d, then this URL works as-is.
DATABASE_URL="postgresql://bjcp:bjcp@localhost:5432/bjcp"

AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Leave BLANK locally. With no key, mail prints to the console and is written
# to .mail/*.eml — nothing is sent, and no real invite can go out by accident.
RESEND_API_KEY=""
EMAIL_FROM=""

# Only needed for generated summaries. Without it the results page shows
# statistics and individual sheets, just no prose summary.
ANTHROPIC_API_KEY=""

CRON_SECRET="run: openssl rand -hex 24"
